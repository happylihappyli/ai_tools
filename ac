#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ac — AI 编译工具启动器 (AI Compile)
================================================================
用法:
    ac                          # 启动 GUI (自动加载 ai_build.json)
    ac --cwd /path/to/proj      # 指定工作目录
    ac --cmd "scons ..."        # 指定编译命令
    ac --test "./run.sh"        # 指定测试命令
    ac help                     # 显示帮助
"""
import os
import sys
import json
import subprocess
from pathlib import Path

# 自动定位 ai_tools 目录 (这个脚本旁边)
GT_DIR = Path(__file__).resolve().parent
COMPILE_TOOL = GT_DIR / "compile_tool.py"
CPP_PANEL = GT_DIR / "cpp_panel" / "ai_panel"


def load_local_config():
    """从当前目录读取 ai_build.json 配置"""
    config_path = Path.cwd() / "ai_build.json"
    if config_path.exists():
        try:
            with open(config_path, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception as e:
            sys.stderr.write(f"⚠ 读取 ai_build.json 失败: {e}\n")
    return {}


def main() -> int:
    local_config = load_local_config()
    
    args = sys.argv[1:]
    
    # 如果命令行没给 --cwd 或 -d，且配置里有，则补上
    if "--cwd" not in args and "-d" not in args and "cwd" in local_config:
        args.extend(["--cwd", local_config["cwd"]])
    
    # 处理 --task 参数: 从 ai_build.json 中查找对应的 task cmd
    task_name = None
    if "--task" in args:
        idx = args.index("--task")
        if idx + 1 < len(args):
            task_name = args[idx + 1]
    
    if task_name and "tasks" in local_config:
        for t in local_config["tasks"]:
            if t.get("name") == task_name:
                # 覆盖 --cmd 参数
                if "--cmd" in args:
                    c_idx = args.index("--cmd")
                    if c_idx + 1 < len(args):
                        args[c_idx + 1] = t["cmd"]
                else:
                    args.extend(["--cmd", t["cmd"]])
                break

    # 如果命令行没给 --cmd 或 -c，且配置里有，则补上 (仅当没指定 task 时)
    if not task_name and "--cmd" not in args and "-c" not in args and "cmd" in local_config:
        args.extend(["--cmd", local_config["cmd"]])

    # 如果命令行没给 --test 或 -t，且配置里有，则补上
    if "--test" not in args and "-t" not in args and "test" in local_config:
        args.extend(["--test", local_config["test"]])

    # 过滤掉 ac 自己的特殊参数
    def filter_args(input_args, exclude_list):
        res = []
        i = 0
        while i < len(input_args):
            arg = input_args[i]
            if arg in exclude_list:
                i += 1
                # 如果是带参数的选项 (如 --test path)，也跳过其后的参数
                if arg in ["--test", "--preset", "--task", "--cmd", "--cwd"]:
                    if i < len(input_args) and not input_args[i].startswith("-"):
                        i += 1
                continue
            res.append(arg)
            i += 1
        return res

    # 决定使用哪个后端
    # 只有显式指定 --cli 时才使用 CLI 模式。
    # --task, --preset, --offscreen 现在默认也走 GUI 模式以避免阻塞，除非同时指定了 --cli。
    use_cli = "--cli" in args
    
    if CPP_PANEL.exists() and not use_cli:
        # C++ 版本不认识 --offscreen 和 --cli
        cmd = [str(CPP_PANEL)] + filter_args(args, ["--offscreen", "--cli"])
    elif COMPILE_TOOL.exists():
        # Python 版本认识 --cli, --task, --preset，但不认识 --offscreen 和 --test
        # 移除强制添加 --cli 的逻辑，尊重用户是否选择 GUI 模式
        cmd = [sys.executable, str(COMPILE_TOOL)] + filter_args(args, ["--offscreen", "--test"])
    else:
        sys.stderr.write(f"✗ 找不到编译工具 (C++ 或 Python 版本)\n")
        return 1

    # 透传环境 (确保 DISPLAY / WAYLAND_DISPLAY 不丢)
    env = os.environ.copy()

    # 透传 Qt 平台设置
    if "QT_QPA_PLATFORM" not in env:
        env["QT_QPA_PLATFORM"] = "offscreen" if "--offscreen" in sys.argv else ""

    try:
        if use_cli:
            # CLI 模式: 同步运行，显示输出
            return subprocess.call(cmd, env=env)
        else:
            # GUI 模式: 异步启动，不阻塞终端，符合用户“不要让我点击”和“GUI 启动”的规则
            # 2026-08-29: 使用 start_new_session=True 彻底分离进程，避免 ac 退出导致 GUI 挂掉
            subprocess.Popen(cmd, env=env, start_new_session=True, 
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"🚀 AI Compile GUI 启动中... (后端: {'compile_tool.py' if COMPILE_TOOL.exists() else 'ai_panel'})")
            print(f"💡 命令已透传，GUI 将自动开始执行。")
            return 0
    except KeyboardInterrupt:
        return 130
    except Exception as e:
        sys.stderr.write(f"✗ ac 启动失败: {e}\n")
        return 1


if __name__ == "__main__":
    sys.exit(main())
