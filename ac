#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
ac — AI 编译工具启动器 (AI Compile)
================================================================
用法:
    ac                          # 启动 GUI (自动加载 ai_build.json)
    ac --cwd /path/to/proj      # 指定工作目录
    ac --cmd "scons ..."        # 指定编译命令
    ac --test "./run.sh"        # 指定测试命令
    ac help                     # 显示帮助
"""
import os
import sys
import json
import subprocess
from pathlib import Path

# 自动定位 ai_tools 目录 (这个脚本旁边)
GT_DIR = Path(__file__).resolve().parent
COMPILE_TOOL = GT_DIR / "compile_tool.py"
CPP_PANEL = GT_DIR / "cpp_panel" / "ai_panel"


def load_local_config():
    """从当前目录读取 ai_build.json 配置"""
    config_path = Path.cwd() / "ai_build.json"
    if config_path.exists():
        try:
            with open(config_path, "r", encoding="utf-8") as f:
                return json.load(f)
        except Exception as e:
            sys.stderr.write(f"⚠ 读取 ai_build.json 失败: {e}\n")
    return {}


def main() -> int:
    local_config = load_local_config()
    
    args = sys.argv[1:]
    
    # 如果命令行没给 --cwd 或 -d，且配置里有，则补上
    if "--cwd" not in args and "-d" not in args and "cwd" in local_config:
        args.extend(["--cwd", local_config["cwd"]])
    
    # 如果命令行没给 --cmd 或 -c，且配置里有，则补上
    if "--cmd" not in args and "-c" not in args and "cmd" in local_config:
        args.extend(["--cmd", local_config["cmd"]])

    # 如果命令行没给 --test 或 -t，且配置里有，则补上
    if "--test" not in args and "-t" not in args and "test" in local_config:
        args.extend(["--test", local_config["test"]])

    # 优先使用 C++ 版本 (ai_panel)
    if CPP_PANEL.exists():
        cmd = [str(CPP_PANEL)] + args
    elif COMPILE_TOOL.exists():
        cmd = [sys.executable, str(COMPILE_TOOL)] + args
    else:
        sys.stderr.write(f"✗ 找不到编译工具 (C++ 或 Python 版本)\n")
        return 1

    # 透传环境 (确保 DISPLAY / WAYLAND_DISPLAY 不丢)
    env = os.environ.copy()

    # 透传 Qt 平台设置
    if "QT_QPA_PLATFORM" not in env:
        env["QT_QPA_PLATFORM"] = "offscreen" if "--offscreen" in sys.argv else ""

    try:
        return subprocess.call(cmd, env=env)
    except KeyboardInterrupt:
        return 130
    except Exception as e:
        sys.stderr.write(f"✗ ac 启动失败: {e}\n")
        return 1


if __name__ == "__main__":
    sys.exit(main())
