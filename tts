#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
tts — 文字转语音 (spd-say 包装, 中文为主)
================================================================
统一的项目级 TTS 工具, 避免每个项目写自己的提示音脚本。

用法:
    tts "编译成功"                       # 默认中文
    tts -l en "compile success"          # 切英文
    tts -r 50 "慢一点说"                  # 调语速 (-100..100, 默认 0)
    tts -p 20 "高音调"                    # 调音调
    tts -v 80 "音量 80"                  # 调音量
    tts --list                           # 列可用语言
    tts --stop                           # 停止当前播报
    tts --cancel                         # 清空队列
    tts --check                          # 自检 (spd-say / 语言是否可用)
    tts -i                               # 交互模式 (REPL)

参数透传给 spd-say 的 5 个 flag:
    -l/--language   -r/--rate   -p/--pitch   -v/--volume   -S/--stop/-C/--cancel

安装:
    ln -sf /home/bv/code/ai_tools/tts ~/.local/bin/tts

依赖:
    spd-say  (sudo apt install speech-dispatcher)
    若想中文好听, 装 espeak-ng + 中文语音:
        sudo apt install espeak-ng speech-dispatcher-espeak-ng
"""
import os
import sys
import shutil
import subprocess
import argparse
from pathlib import Path

DEFAULT_LANG = "zh"
SPD_SAY = "spd-say"

# 常见事件 → 中文播报 (供 ac 集成调用)
EVENT_TEMPLATES = {
    "compile_start":   "开始编译",
    "compile_ok":      "编译成功",
    "compile_fail":    "编译失败, {n} 个错误",
    "compile_warn":    "编译完成, {n} 个警告",
    "test_start":      "开始测试",
    "test_ok":         "测试通过",
    "test_fail":       "测试失败",
    "deploy_ok":       "部署完成",
    "deploy_fail":     "部署失败",
}


def check_spd_say() -> bool:
    return shutil.which(SPD_SAY) is not None


def list_languages() -> int:
    """列 spd-say 支持的所有合成声音 (含语言)"""
    if not check_spd_say():
        sys.stderr.write(f"✗ 找不到 {SPD_SAY}, 请安装: sudo apt install speech-dispatcher\n")
        return 1
    return subprocess.call([SPD_SAY, "-L"])


def check() -> int:
    """自检: spd-say 是否可用 + 默认语言是否能播"""
    if not check_spd_say():
        sys.stderr.write(f"✗ 找不到 {SPD_SAY}\n")
        sys.stderr.write("  安装: sudo apt install speech-dispatcher espeak-ng\n")
        return 1
    print(f"✓ {SPD_SAY}: {shutil.which(SPD_SAY)}")
    print(f"  可用合成声音 (spd-say -L) 节选:")
    # 取前 5 行展示
    out = subprocess.run([SPD_SAY, "-L"], capture_output=True, text=True)
    for ln in out.stdout.splitlines()[:5]:
        print(f"    {ln}")
    # 尝试用默认语言播一个测试词
    print(f"  测试播报 ({DEFAULT_LANG}): tts 自检...")
    rc = subprocess.call([SPD_SAY, "-l", DEFAULT_LANG, "tts 自检完成"])
    if rc != 0:
        sys.stderr.write(f"  ⚠ 默认语言 ({DEFAULT_LANG}) 播报失败 (rc={rc})\n")
        sys.stderr.write(f"    试 `tts --list` 看可用声音, 或 -l en 切英文\n")
        return rc
    return 0


def stop() -> int:
    if not check_spd_say():
        sys.stderr.write(f"✗ 找不到 {SPD_SAY}\n")
        return 1
    return subprocess.call([SPD_SAY, "-S"])


def cancel() -> int:
    if not check_spd_say():
        sys.stderr.write(f"✗ 找不到 {SPD_SAY}\n")
        return 1
    return subprocess.call([SPD_SAY, "-C"])


def say(text: str, lang: str = DEFAULT_LANG, rate: int = 0,
        pitch: int = 0, volume: int = 0, wait: bool = False) -> int:
    """播报一条消息"""
    if not check_spd_say():
        sys.stderr.write(f"✗ 找不到 {SPD_SAY}\n")
        return 1
    if not text.strip():
        return 0
    cmd = [SPD_SAY, "-l", lang]
    if rate:
        cmd += ["-r", str(rate)]
    if pitch:
        cmd += ["-p", str(pitch)]
    if volume:
        # spd-say 用 -i/--volume 表示音量 (intensity)
        cmd += ["-i", str(volume)]
    if wait:
        cmd += ["-w"]
    cmd.append(text)
    return subprocess.call(cmd)


def event(name: str, **kwargs) -> int:
    """按预定义事件播报, 例: tts --event compile_fail --n 3"""
    tmpl = EVENT_TEMPLATES.get(name)
    if not tmpl:
        sys.stderr.write(f"✗ 未知事件: {name}\n")
        sys.stderr.write(f"  可用: {', '.join(EVENT_TEMPLATES.keys())}\n")
        return 1
    text = tmpl.format(**kwargs)
    print(f"[tts event={name}] {text}")
    return say(text)


def interactive() -> int:
    """REPL: 一行一条消息, Ctrl+D 退出"""
    print("tts 交互模式 (输入消息回车播报, Ctrl+D 退出, :q 退出, :stop 停止, :list 列表)")
    try:
        import readline  # noqa: F401  让方向键可用
    except Exception:
        pass
    while True:
        try:
            line = input("tts> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not line:
            continue
        if line in (":q", ":quit", ":exit"):
            return 0
        if line == ":stop":
            stop()
            continue
        if line == ":cancel":
            cancel()
            continue
        if line == ":list":
            list_languages()
            continue
        if line == ":check":
            check()
            continue
        # 支持行内 -l 切语言: ":en hello world"
        lang = DEFAULT_LANG
        if line.startswith(":en "):
            lang = "en"
            line = line[4:]
        elif line.startswith(":zh "):
            lang = "zh"
            line = line[4:]
        say(line, lang=lang)


def main() -> int:
    p = argparse.ArgumentParser(
        prog="tts",
        description="项目级 TTS 工具 (spd-say 包装)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="例: tts \"编译成功\" | tts -l en \"compile success\" | tts --check",
    )
    p.add_argument("text", nargs="*", help="要播报的文字 (空格分隔的多个参数会拼起来)")
    p.add_argument("-l", "--language", default=DEFAULT_LANG,
                   help=f"语言代码 (默认 {DEFAULT_LANG}, 例: zh / en / en-US / ja)")
    p.add_argument("-r", "--rate", type=int, default=0,
                   help="语速 -100..100 (默认 0 = 系统)")
    p.add_argument("-p", "--pitch", type=int, default=0,
                   help="音调 -100..100 (默认 0)")
    p.add_argument("-v", "--volume", type=int, default=0,
                   help="音量 -100..100 (默认 0)")
    p.add_argument("-w", "--wait", action="store_true",
                   help="等播报完成再返回")
    p.add_argument("-i", "--interactive", action="store_true",
                   help="交互模式 (REPL)")
    p.add_argument("-e", "--event",
                   help=f"播预定义事件: {', '.join(EVENT_TEMPLATES.keys())}")
    p.add_argument("-n", type=int, default=0,
                   help="配合 --event, 传错误/警告数 (例: --event compile_fail -n 3)")
    p.add_argument("--list", action="store_true", help="列可用语言")
    p.add_argument("--stop", action="store_true", help="停止当前播报")
    p.add_argument("--cancel", action="store_true", help="清空队列")
    p.add_argument("--check", action="store_true", help="自检 (spd-say + 默认语言)")
    args = p.parse_args()

    if args.check:
        return check()
    if args.list:
        return list_languages()
    if args.stop:
        return stop()
    if args.cancel:
        return cancel()
    if args.interactive:
        return interactive()
    if args.event:
        kwargs = {"n": args.n} if args.n else {}
        return event(args.event, **kwargs)
    if not args.text:
        p.print_help()
        return 1

    text = " ".join(args.text)
    return say(text, lang=args.language, rate=args.rate,
               pitch=args.pitch, volume=args.volume, wait=args.wait)


if __name__ == "__main__":
    sys.exit(main())
