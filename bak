#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
bak — 项目级文件备份工具 (本地带时间戳 .bak)
================================================================
统一的项目级备份工具, 避免每个项目写自己的 backup 脚本。

文件名规则:  <orig>.YYYYMMDD_HHMMSS.bak
例:          workspace.h.20260901_155500.bak

用法:
    bak <file> [<file2> ...]            # 备份一个/多个文件/目录
    bak --list                         # 列当前目录所有 .bak (按时间倒序)
    bak --probe <file>                 # 看某文件的所有历史 .bak 版本
    bak --restore <file>               # 恢复到最近一个 .bak
    bak --restore <file> -i N          # 恢复到第 N 个版本 (按 --probe 列表)
    bak --delete <file>                # 删某文件所有 .bak
    bak --max N <file>                 # 备份后只保留最近 N 个 (轮转)
    bak --dry <file>                   # 试运行, 不真做
    bak --info                         # 显示工具信息 + 路径

安装:
    ln -sf /home/bv/code/ai_tools/bak ~/.local/bin/bak

为什么这个设计:
- 本地 .bak 不依赖外部存储 / 网络 / 任何后台服务
- 时间戳后缀天然支持无限历史 (不像 .bak 单文件覆盖就丢)
- glob 模式 (<orig>*.bak) 让 -l/-p/-r 不用解析时间戳
- 目录也能备份 (cp -r), 同样加 .<ts>.bak 后缀
"""
import os
import sys
import shutil
import argparse
import fnmatch
import re
from pathlib import Path
from datetime import datetime

TS_FMT = "%Y%m%d_%H%M%S"
TS_REGEX = re.compile(r"\.(\d{8}_\d{6})\.bak$")


def now_ts() -> str:
    return datetime.now().strftime(TS_FMT)


def parse_ts_from_bak(path: Path) -> datetime | None:
    """从 .bak 文件名解析时间戳, 返回 datetime 或 None"""
    m = TS_REGEX.search(path.name)
    if not m:
        return None
    try:
        return datetime.strptime(m.group(1), TS_FMT)
    except ValueError:
        return None


def bak_path_for(src: Path, ts: str | None = None) -> Path:
    """生成 <src>.<ts>.bak 路径"""
    ts = ts or now_ts()
    if src.is_dir():
        # 目录: /foo/bar  -> /foo/bar.20260901_155500.bak/  (末尾加 /)
        return src.parent / f"{src.name}.{ts}.bak"
    return src.parent / f"{src.name}.{ts}.bak"


def list_bak_for(src: Path) -> list[Path]:
    """列某文件/目录的所有 .bak 版本, 按时间倒序 (新→旧)"""
    pattern = f"{src.name}.*.bak"
    matches = sorted(
        src.parent.glob(pattern),
        key=lambda p: parse_ts_from_bak(p) or datetime.min,
        reverse=True,
    )
    return matches


def do_backup(src: Path, max_keep: int | None = None,
              dry: bool = False, verbose: bool = True) -> int:
    """备份一个文件/目录"""
    if not src.exists():
        sys.stderr.write(f"✗ {src}: 不存在\n")
        return 1
    dst = bak_path_for(src)
    if dst.exists():
        # 同秒内重复 backup: 跳过, 避免覆盖丢历史
        if verbose:
            print(f"  ↳ {dst} 同秒已存在, 跳过重复备份 (避免覆盖)")
        # 但仍执行轮转 (如果用户要求)
    else:
        if dry:
            if src.is_dir():
                print(f"[dry-run] cp -r {src} → {dst}/")
            else:
                print(f"[dry-run] cp {src} → {dst}")
        else:
            if src.is_dir():
                shutil.copytree(src, dst)
            else:
                shutil.copy2(src, dst)
            if verbose:
                size = sum(p.stat().st_size for p in dst.rglob("*") if p.is_file()) if dst.is_dir() else dst.stat().st_size
                print(f"✓ 备份 {src} → {dst}  ({size} bytes)")
    # 轮转: 只保留最近 N 个
    if max_keep is not None and max_keep > 0:
        all_bak = list_bak_for(src)
        to_delete = all_bak[max_keep:]
        for old in to_delete:
            if dry:
                print(f"[dry-run] rm {old}  (轮转, 保留 {max_keep} 个)")
            else:
                if old.is_dir():
                    shutil.rmtree(old)
                else:
                    old.unlink()
                if verbose:
                    print(f"  ↳ 删旧备份 {old}  (轮转, 保留 {max_keep} 个)")
    return 0


def do_list(cwd: Path) -> int:
    """列当前目录所有 .bak 文件/目录, 按时间分组"""
    baks = sorted(
        list(cwd.glob("*.bak")) + [p for p in cwd.iterdir() if p.is_dir() and p.name.endswith(".bak")],
        key=lambda p: parse_ts_from_bak(p) or datetime.min,
        reverse=True,
    )
    if not baks:
        print("(当前目录无 .bak 文件)")
        return 0
    print(f"{'时间戳':<18} {'类型':<6} {'大小':>10}  路径")
    print("-" * 70)
    for b in baks:
        ts = parse_ts_from_bak(b)
        ts_str = ts.strftime("%Y-%m-%d %H:%M:%S") if ts else "(无法解析)"
        kind = "目录" if b.is_dir() else "文件"
        if b.is_dir():
            size = sum(p.stat().st_size for p in b.rglob("*") if p.is_file())
            size_str = f"{size:>10}"
        else:
            size_str = f"{b.stat().st_size:>10}"
        print(f"{ts_str:<18} {kind:<6} {size_str}  {b}")
    return 0


def do_probe(src: Path) -> int:
    """看某文件的所有 .bak 历史, 给 --restore -i 用"""
    if not src.exists():
        # 即使原文件不在了, 也允许看 .bak 历史
        parent = src.parent
        if not parent.exists():
            sys.stderr.write(f"✗ {parent}: 父目录不存在\n")
            return 1
    baks = list_bak_for(src)
    if not baks:
        print(f"(无 {src.name} 的 .bak 历史)")
        return 0
    print(f"{'#':<4} {'时间戳':<18} {'大小':>10}  路径")
    print("-" * 70)
    for i, b in enumerate(baks, 1):
        ts = parse_ts_from_bak(b)
        ts_str = ts.strftime("%Y-%m-%d %H:%M:%S") if ts else "(无法解析)"
        if b.is_dir():
            size = sum(p.stat().st_size for p in b.rglob("*") if p.is_file())
        else:
            size = b.stat().st_size
        print(f"{i:<4} {ts_str:<18} {size:>10}  {b}")
    print(f"\n恢复: bak --restore {src} -i <#>")
    return 0


def do_restore(src: Path, index: int = 1, dry: bool = False,
               verbose: bool = True) -> int:
    """恢复 src 到第 N 个 .bak 版本 (1=最近)"""
    baks = list_bak_for(src)
    if not baks:
        sys.stderr.write(f"✗ 无 {src.name} 的 .bak 历史\n")
        return 1
    if index < 1 or index > len(baks):
        sys.stderr.write(f"✗ 索引 {index} 越界 (1..{len(baks)})\n")
        return 1
    chosen = baks[index - 1]
    # 安全确认: 如果目标已存在且比 .bak 新, 警告
    if src.exists() and not dry:
        # 自动备份当前 (以防覆盖)
        print(f"⚠ {src} 已存在, 先备份当前状态")
        do_backup(src, verbose=False)
    if dry:
        if chosen.is_dir():
            print(f"[dry-run] rm -rf {src} && cp -r {chosen} → {src}")
        else:
            print(f"[dry-run] cp {chosen} → {src}")
    else:
        if src.exists() or src.is_symlink():
            if src.is_dir() and not src.is_symlink():
                shutil.rmtree(src)
            else:
                src.unlink()
        if chosen.is_dir():
            shutil.copytree(chosen, src)
        else:
            shutil.copy2(chosen, src)
        if verbose:
            ts = parse_ts_from_bak(chosen)
            ts_str = ts.strftime("%Y-%m-%d %H:%M:%S") if ts else "?"
            print(f"✓ 恢复 {src} ← {chosen}  (时间戳 {ts_str})")
    return 0


def do_delete(src: Path, dry: bool = False, verbose: bool = True) -> int:
    """删某文件/目录的所有 .bak"""
    baks = list_bak_for(src)
    if not baks:
        print(f"(无 {src.name} 的 .bak, 不用删)")
        return 0
    for b in baks:
        if dry:
            print(f"[dry-run] rm {b}")
        else:
            if b.is_dir():
                shutil.rmtree(b)
            else:
                b.unlink()
            if verbose:
                print(f"  ↳ 删 {b}")
    print(f"✓ 删了 {len(baks)} 个 {src.name} 的 .bak")
    return 0


def do_info() -> int:
    print("bak — 项目级文件备份工具")
    print(f"  安装路径: {Path(__file__).resolve()}")
    print(f"  链接:      ~/.local/bin/bak")
    print(f"  时间戳:    {now_ts()}")
    print(f"  当前目录:  {Path.cwd()}")
    print()
    print("命名规则: <orig>.YYYYMMDD_HHMMSS.bak")
    return 0


def main() -> int:
    p = argparse.ArgumentParser(
        prog="bak",
        description="项目级文件备份工具 (本地带时间戳 .bak)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="例: bak workspace.h | bak --list | bak --probe workspace.h | "
               "bak --restore workspace.h -i 2",
    )
    p.add_argument("paths", nargs="*", help="要备份的文件/目录")
    p.add_argument("-l", "--list", action="store_true",
                   help="列当前目录所有 .bak (按时间倒序)")
    p.add_argument("-p", "--probe", metavar="FILE",
                   help="看某文件/目录的所有 .bak 历史")
    p.add_argument("-r", "--restore", metavar="FILE",
                   help="从 .bak 恢复文件/目录")
    p.add_argument("-i", "--index", type=int, default=1,
                   help="配合 --restore, 第 N 个版本 (1=最近, 默认 1)")
    p.add_argument("-d", "--delete", metavar="FILE",
                   help="删某文件/目录的所有 .bak")
    p.add_argument("--max", type=int, default=0, metavar="N",
                   help="备份后只保留最近 N 个版本 (0=不轮转)")
    p.add_argument("--dry", action="store_true",
                   help="试运行, 只显示不真做")
    p.add_argument("--info", action="store_true",
                   help="显示工具信息")
    p.add_argument("-q", "--quiet", action="store_true",
                   help="静默 (只显示错误)")
    args = p.parse_args()

    verbose = not args.quiet

    if args.info:
        return do_info()
    if args.list:
        return do_list(Path.cwd())
    if args.probe:
        return do_probe(Path(args.probe))
    if args.restore:
        return do_restore(Path(args.restore), args.index, args.dry, verbose)
    if args.delete:
        return do_delete(Path(args.delete), args.dry, verbose)
    if not args.paths:
        p.print_help()
        return 1

    # 默认: 备份 paths
    rc = 0
    for p_str in args.paths:
        rc |= do_backup(Path(p_str), max_keep=args.max or None,
                       dry=args.dry, verbose=verbose)
    return rc


if __name__ == "__main__":
    sys.exit(main())
